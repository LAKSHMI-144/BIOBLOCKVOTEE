# Copy to .env and fill in. NEVER commit .env
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=securevoteai

PYTHON_AI_URL=http://localhost:5001
# Must be identical to INTERNAL_API_KEY in python_ai/.env
INTERNAL_API_KEY=change_me_to_a_long_random_string

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Admin login (generate the two secrets with: node scripts/hash-admin-password.js "your-password")
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN_SECRET=

# Signs registration and voter-session tokens. Any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a random one is used per start (sessions are lost on every restart).
SESSION_SECRET=

# Identity verification step in registration: required | off
IDENTITY_MODE=required
# mock = DEVELOPMENT/DEMO ONLY (no real verification, no SMS). A real provider must be plugged in for production.
IDENTITY_PROVIDER=mock
# Test OTP accepted by the mock provider
DEV_MOCK_OTP=123456
