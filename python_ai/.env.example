# Copy to .env and fill in. NEVER commit .env
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=securevoteai

# Shared secret between Node server and this service (any long random string).
# Must be identical to INTERNAL_API_KEY in server/.env
INTERNAL_API_KEY=change_me_to_a_long_random_string

# Encrypts face embeddings at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_ENCRYPTION_KEY=

# Browser origins allowed to call this service directly (Blockchain page does)
CORS_ORIGINS=http://localhost:5173

# Optional tuning
# FACE_MODEL=buffalo_l          (buffalo_sc = lighter/faster)
# FACE_MATCH_THRESHOLD=0.45     (cosine similarity, higher = stricter)
# FLASK_DEBUG=0
PORT=5001
